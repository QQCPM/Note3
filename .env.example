# Note3 AI Configuration
# =======================

# OpenAI API Key (get from https://platform.openai.com/api-keys)
VITE_OPENAI_API_KEY=sk-...your-key-here

# Ollama Cloud API Key (get from https://ollama.com/settings/keys)
# Used for GLM-4.6 code generation in demo mode
VITE_OLLAMA_API_KEY=ollama-...your-key-here

# AI Mode - choose based on your hardware:
#   m2-pro        - Mac M2 Pro 16GB (local embedding + cloud code gen)
#   m2-pro-hybrid - Mac M2 Pro 16GB (local embedding + reranker + cloud)
#   m2-ultra      - Mac M2 Ultra 64GB+ (full local models)
#   cloud-only    - No local models (everything via OpenAI API)
#   demo          - GLM-4.6 via Ollama Cloud
VITE_AI_MODE=m2-pro

# To start the app:
# Option 1 (M2 Pro 16GB): npm run ai:m2pro && npm run tauri:dev
# Option 2 (Cloud only):  npm run tauri:dev (set VITE_AI_MODE=cloud-only)
# Option 3 (M2 Ultra):    npm run ai && npm run tauri:dev
