{
  "name": "note",
  "version": "0.1.0",
  "description": "AI-native note-taking platform",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "tauri:build:all": "./build-all.sh",
    "tauri:build:win": "tauri build --target x86_64-pc-windows-gnu",
    "tauri:build:linux": "tauri build --target x86_64-unknown-linux-gnu",
    "tauri:build:macos": "tauri build --target x86_64-apple-darwin",
    "tauri:build:macos-arm": "tauri build --target aarch64-apple-darwin",
    "embed": "./start-embedding.sh",
    "ai": "./start-ai.sh",
    "ai:m2pro": "./start-m2pro.sh",
    "start": "echo '1. Run: npm run embed (starts embedding for search)' && echo '2. Run: npm run tauri:dev (starts app)'",
    "clean": "rm -rf src-tauri/target/release/bundle dist",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\""
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@google/genai": "^1.0.0",
    "@hello-pangea/dnd": "^18.0.1",
    "@langchain/core": "^1.1.8",
    "@langchain/langgraph": "^1.0.7",
    "@langchain/openai": "^1.2.0",
    "@lexical/markdown": "^0.13.1",
    "@lexical/react": "^0.13.1",
    "@lexical/rich-text": "^0.13.1",
    "@lexical/selection": "^0.13.1",
    "@lexical/utils": "^0.13.1",
    "@llamaindex/google": "^0.4.0",
    "@tanstack/react-query": "^5.28.4",
    "@tauri-apps/api": "^2.0.0",
    "@tauri-apps/plugin-dialog": "^2.4.2",
    "@tauri-apps/plugin-shell": "^2.0.0",
    "date-fns": "^3.3.1",
    "diff": "^8.0.2",
    "eventsource-parser": "^3.0.6",
    "jspdf": "^3.0.4",
    "jszip": "^3.10.1",
    "katex": "^0.16.25",
    "lexical": "^0.13.1",
    "llamaindex": "^0.12.1",
    "lucide-react": "^0.553.0",
    "mermaid": "^11.12.2",
    "nanoid": "^5.0.6",
    "react": "^18.3.1",
    "react-diff-view": "^3.3.2",
    "react-dom": "^18.3.1",
    "react-force-graph-3d": "^1.29.0",
    "react-katex": "^3.1.0",
    "react-markdown": "^10.1.0",
    "react-pdf": "^10.2.0",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "three": "^0.182.0",
    "zod": "^4.2.1",
    "zustand": "^4.5.2"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.19",
    "@tauri-apps/cli": "^2.0.0",
    "@types/diff": "^7.0.2",
    "@types/katex": "^0.16.7",
    "@types/react": "^18.3.1",
    "@types/react-dom": "^18.3.0",
    "@types/three": "^0.182.0",
    "@typescript-eslint/eslint-plugin": "^7.4.0",
    "@typescript-eslint/parser": "^7.4.0",
    "@vitejs/plugin-react": "^4.2.1",
    "@vitest/ui": "^1.4.0",
    "autoprefixer": "^10.4.19",
    "crypto-browserify": "^3.12.1",
    "eslint": "^8.57.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.6",
    "postcss": "^8.4.38",
    "prettier": "^3.2.5",
    "tailwindcss": "^3.4.3",
    "typescript": "^5.4.3",
    "vite": "^5.2.6",
    "vitest": "^1.4.0"
  }
}
